#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R         &kp T          &kp Y        &kp U          &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D  &kp F         &kp G          &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V         &kp B          &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &mo 3  &kp LEFT_GUI  &lt 1 ENTER    &lt 2 SPACE  &kp BACKSPACE  &mo 4
            >;
        };

        layer_1 {
            bindings = <
&trans     &kp LS(N1)      &kp LS(A)  &kp LS(N3)     &kp LS(N4)        &kp LS(N5)        &kp LS(N6)       &kp LS(N7)         &kp LS(N8)        &kp LS(N9)  &kp LS(N0)  &trans
&trans     &kp N1          &kp N2     &kp N3         &kp N4            &kp N5            &kp N6           &kp N7             &kp N8            &kp N9      &kp N0      &trans
&kp TILDE  &kp UNDERSCORE  &kp EQUAL  &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN  &kp PLUS    &kp MINUS   &kp GRAVE
                                      &trans         &trans            &trans            &kp LG(LS(S))    &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &trans  &trans    &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DEC  &kp C_BRI_UP  &trans
&trans  &kp LA(Q)         &kp LA(W)         &kp LA(E)         &trans  &trans    &kp LEFT    &kp DOWN           &kp UP           &kp RIGHT      &kp F12       &trans
&trans  &kp LA(A)         &kp LA(S)         &trans            &trans  &trans    &trans      &trans             &trans           &trans         &trans        &trans
                                            &trans            &trans  &trans    &trans      &trans             &trans
            >;
        };

        layer_3 {
            bindings = <
&trans          &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
